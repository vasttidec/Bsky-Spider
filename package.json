{
  "name": "bsky-spider",
  "version": "1.2.5",
  "private": true,
  "description": "Bsky-Spider — a local Bluesky media downloader",
  "author": {
    "name": "VastTideC"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "build:web": "vite build",
    "build:server": "tsup",
    "build": "npm run typecheck && npm run build:web && npm run build:server",
    "build:exe": "npm run build && electron-builder --win portable --x64",
    "build:exe:dir": "npm run build && electron-builder --win dir --x64 && npm run patch:exe",
    "build:zip": "npm run build:exe:dir && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-zip.ps1",
    "patch:exe": "node scripts/patch-exe-metadata.mjs",
    "start": "cross-env NODE_ENV=production node dist/server/index.cjs",
    "start:desktop": "electron .",
    "test": "tsc --noEmit",
    "test:auth": "tsx scripts/test-auth.ts",
    "test:download": "tsx scripts/test-download.ts",
    "test:pause": "tsx scripts/test-pause.ts",
    "test:proxy": "tsx scripts/test-proxy.ts",
    "test:proxy-auto": "tsx scripts/test-proxy-auto.ts",
    "test:original": "tsx scripts/test-original.ts",
    "test:auto-login": "tsx scripts/test-auto-login.ts",
    "test:server": "tsx scripts/test-server.ts",
    "test:ui": "node scripts/test-ui.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "preview": "npm run build && npm run start",
    "test:history": "tsx scripts/test-history.ts",
    "test:webdav": "tsx scripts/test-webdav.ts",
    "build:setup": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.22.7",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^7.2.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "pe-library": "^0.4.1",
    "playwright-core": "^1.50.0",
    "postcss": "^8.5.1",
    "resedit": "^1.7.2",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
